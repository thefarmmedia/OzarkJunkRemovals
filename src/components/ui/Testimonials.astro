---
/** Renders nothing until real reviews are added in src/data/reviews.ts. */
import { reviews } from '@/data/reviews';
import SectionHeading from './SectionHeading.astro';
---

{
  reviews.length > 0 && (
    <section class="bg-ink py-20 lg:py-28" aria-labelledby="reviews-title">
      <div class="container-x">
        <SectionHeading id="reviews-title" eyebrow="Customer reviews" title="What customers say" />
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {reviews.map((r, i) => (
            <figure class="card reveal flex flex-col p-7" style={`--d:${i * 70}ms`}>
              <blockquote class="flex-1 text-lg text-white/90">&ldquo;{r.quote}&rdquo;</blockquote>
              <figcaption class="mt-6 border-t border-line pt-4">
                <span class="font-display text-lg font-bold uppercase">{r.name}</span>
                {r.location && <span class="block text-sm text-mute">{r.location}</span>}
                {r.source && (
                  <a href={r.source.url} class="mt-1 block text-sm text-blue underline" rel="noopener" target="_blank">
                    {r.source.label}
                  </a>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
