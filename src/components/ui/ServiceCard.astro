---
import Icon from './Icon.astro';
import type { Service } from '@/data/services';
interface Props { service: Service; index?: number; featured?: boolean }
const { service, index = 0, featured = false } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<a
  href={`/services/${service.slug}/`}
  class:list={['card card-glow group reveal flex h-full flex-col p-6 transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-blue/60 sm:p-7', featured && 'border-orange/40']}
  style={`--d:${(index % 4) * 70}ms`}
>
  <div class="flex items-start justify-between">
    <span class="grid size-14 place-items-center bg-orange/10 text-orange ring-1 ring-orange/30 transition-colors duration-300 group-hover:bg-orange group-hover:text-ink" style="clip-path: polygon(0 0, 78% 0, 100% 22%, 100% 100%, 0 100%)">
      <Icon name={service.icon} size={28} />
    </span>
    <span class="font-display text-sm font-bold tracking-[0.2em] text-white/25" aria-hidden="true">{num}</span>
  </div>
  <h3 class="mt-6 font-display text-[1.7rem] font-extrabold uppercase italic leading-none">{service.cardTitle}</h3>
  <p class="mt-3 flex-1 text-mute">{service.cardBlurb}</p>
  <span class="mt-6 inline-flex items-center gap-2 font-display font-bold uppercase tracking-wider text-blue">
    Learn more <span class="sr-only">about {service.name}</span>
    <Icon name="arrow" size={18} class="transition-transform duration-300 group-hover:translate-x-1.5" />
  </span>
</a>
