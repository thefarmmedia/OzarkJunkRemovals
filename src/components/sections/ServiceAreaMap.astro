---
/**
 * Service-area presentation: a schematic map (relative positions from real
 * coordinates, simplified) + linked city cards.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { cities as allCities, coreAreaCities as cities, cityPath, SERVICE_RADIUS_MILES } from '@/data/cities';

interface Props { heading?: boolean }
const { heading = true } = Astro.props;

// Approximate town-center coordinates (lat, lon) → schematic positions.
const coords: Record<string, [number, number]> = {
  springfield: [37.209, -93.292],
  willard: [37.305, -93.428],
  strafford: [37.268, -93.117],
  rogersville: [37.117, -93.056],
  ozark: [37.021, -93.206],
  nixa: [37.043, -93.294],
  battlefield: [37.116, -93.37],
  republic: [37.12, -93.48],
};
const W = 600, H = 420, pad = 70;
const lats = Object.values(coords).map((c) => c[0]);
const lons = Object.values(coords).map((c) => c[1]);
const [minLat, maxLat, minLon, maxLon] = [Math.min(...lats), Math.max(...lats), Math.min(...lons), Math.max(...lons)];
const pos = (slug: string) => {
  const [lat, lon] = coords[slug];
  return {
    x: pad + ((lon - minLon) / (maxLon - minLon)) * (W - pad * 2),
    y: pad + ((maxLat - lat) / (maxLat - minLat)) * (H - pad * 2),
  };
};
const hub = pos('springfield');
const others = cities.filter((c) => !c.primary);
const primary = cities.find((c) => c.primary)!;
---

<section class="relative overflow-hidden bg-charcoal py-20 lg:py-28" aria-labelledby={heading ? 'areas-title' : undefined}>
  <div class="container-x">
    {
      heading && (
        <SectionHeading
          id="areas-title"
          eyebrow="Service areas"
          title="Springfield & the surrounding Ozarks"
          highlight="Springfield"
          intro={`Based in Springfield and serving ${allCities.length} towns within ${SERVICE_RADIUS_MILES} miles — from Bolivar to Branson and Mount Vernon to Lebanon. Not sure if you're in range? Send a request and we'll let you know.`}
        />
      )
    }

    <div class="mt-12 grid items-center gap-10 lg:grid-cols-[1.15fr_1fr]">
      <!-- map -->
      <div class="reveal card relative border-blue/20 bg-ink p-2 sm:p-4">
        <svg viewBox={`0 0 ${W} ${H}`} class="w-full" role="img" aria-labelledby="map-desc">
          <title id="map-desc">Schematic map of Springfield, Missouri and the surrounding towns we serve</title>
          <defs>
            <radialGradient id="map-glow"><stop offset="0" stop-color="#FF5F00" stop-opacity=".35" /><stop offset="1" stop-color="#FF5F00" stop-opacity="0" /></radialGradient>
          </defs>
          <g stroke="#00BFFF" stroke-opacity=".07">
            {Array.from({ length: 13 }, (_, i) => <path d={`M${i * 50} 0V${H}`} />)}
            {Array.from({ length: 9 }, (_, i) => <path d={`M0 ${i * 50}H${W}`} />)}
          </g>
          {[90, 170, 250].map((r) => <circle cx={hub.x} cy={hub.y} r={r} fill="none" stroke="#00BFFF" stroke-opacity=".14" stroke-dasharray="4 6" />)}
          <circle cx={hub.x} cy={hub.y} r="120" fill="url(#map-glow)" />
          {others.map((c) => { const p = pos(c.slug); return <path class="route" d={`M${hub.x} ${hub.y}L${p.x} ${p.y}`} stroke="#00BFFF" stroke-opacity=".55" stroke-width="2" stroke-dasharray="2 6" />; })}
          {others.map((c) => {
            const p = pos(c.slug);
            const left = p.x > W - 140;
            return (
              <a href={cityPath(c.slug)} class="map-pin">
                <circle cx={p.x} cy={p.y} r="16" fill="#00BFFF" fill-opacity=".12" />
                <circle cx={p.x} cy={p.y} r="7" fill="#0B0D10" stroke="#00BFFF" stroke-width="3" />
                <text x={left ? p.x - 14 : p.x + 14} y={p.y + 5} text-anchor={left ? 'end' : 'start'} fill="#fff" font-family="Barlow Condensed, sans-serif" font-weight="700" font-size="19" letter-spacing="1">{c.name.toUpperCase()}</text>
              </a>
            );
          })}
          <a href={cityPath(primary.slug)} class="map-pin">
            <circle cx={hub.x} cy={hub.y} r="22" fill="#FF5F00" fill-opacity=".25" class="hub-pulse" />
            <rect x={hub.x - 11} y={hub.y - 11} width="22" height="22" transform={`rotate(45 ${hub.x} ${hub.y})`} fill="#FF5F00" />
            <text x={hub.x + 22} y={hub.y - 16} fill="#FF5F00" font-family="Barlow Condensed, sans-serif" font-weight="800" font-style="italic" font-size="28" letter-spacing="1">SPRINGFIELD</text>
          </a>
          <text x={W - 16} y={H - 14} text-anchor="end" fill="#A7ADB7" font-size="11" font-family="Barlow, sans-serif">Schematic · not to scale</text>
        </svg>
      </div>

      <!-- city list -->
      <div class="reveal" style="--d:120ms">
        <a href={cityPath(primary.slug)} class="card card-glow group flex items-center justify-between gap-4 border-orange/50 p-6 transition hover:border-orange">
          <span>
            <span class="block font-display text-sm font-bold uppercase tracking-[0.2em] text-orange">Home base</span>
            <span class="display block text-4xl leading-none">Springfield, MO</span>
            <span class="mt-1 block text-sm text-mute">{primary.county} · All Springfield ZIP codes</span>
          </span>
          <Icon name="arrow" size={26} class="shrink-0 text-orange transition group-hover:translate-x-1" />
        </a>
        <ul class="mt-3 grid grid-cols-2 gap-3">
          {others.map((c) => (
            <li>
              <a href={cityPath(c.slug)} class="card group flex h-full items-center justify-between gap-2 p-4 transition hover:border-blue/60">
                <span>
                  <span class="block font-display text-xl font-extrabold uppercase italic leading-none">{c.name}</span>
                  <span class="mt-1 block text-xs text-mute">{c.relation}</span>
                </span>
                <Icon name="arrow" size={18} class="shrink-0 text-blue transition group-hover:translate-x-1" />
              </a>
            </li>
          ))}
        </ul>
        <a href="/service-areas/" class="mt-5 inline-flex items-center gap-2 font-display font-bold uppercase tracking-wider text-blue hover:underline">All {allCities.length} service areas <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .map-pin text, .map-pin circle, .map-pin rect { transition: fill 0.2s, fill-opacity 0.2s; }
  .map-pin:hover text, .map-pin:focus-visible text { fill: #00bfff; }
  .route { stroke-dashoffset: 0; animation: route 1.6s linear infinite; }
  @keyframes route { to { stroke-dashoffset: -16; } }
  .hub-pulse { transform-origin: center; transform-box: fill-box; animation: hub 2.4s ease-out infinite; }
  @keyframes hub { 0% { transform: scale(0.6); opacity: 1; } 100% { transform: scale(2.2); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .route, .hub-pulse { animation: none; } }
</style>
