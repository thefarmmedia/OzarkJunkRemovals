---
/**
 * Before / after gallery. Renders real projects from src/data/projects.ts.
 * With no projects yet, it shows an honest "coming soon" state with a labelled
 * demo of the slider interaction (illustration only — not a real job).
 */
import { Image } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { projects } from '@/data/projects';
import { getService } from '@/data/services';

interface Props { limit?: number; showEmptyState?: boolean }
const { limit = 6, showEmptyState = true } = Astro.props;
const list = projects.slice(0, limit);
---

{
  (list.length > 0 || showEmptyState) && (
    <section class="relative overflow-hidden bg-charcoal py-20 lg:py-28" aria-labelledby="ba-title">
      <div class="grid-bg pointer-events-none absolute inset-0 opacity-60" aria-hidden="true" />
      <div class="container-x relative">
        <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
          <SectionHeading
            id="ba-title"
            eyebrow="Before & after"
            title="Real jobs. Real results."
            highlight="Real results."
            intro={list.length ? 'Drag the slider to see the difference a single visit makes.' : "We're not going to fill this space with stock photos. Real before-and-after shots from local jobs will show up here as we complete them."}
          />
        </div>

        {list.length > 0 ? (
          <div class="mt-12 grid gap-8 md:grid-cols-2">
            {list.map((p, i) => (
              <figure class="reveal" style={`--d:${(i % 2) * 100}ms`}>
                <div class="ba-slider card relative aspect-[4/3] select-none overflow-hidden" style="--pos:50%">
                  <Image src={p.after} alt={p.afterAlt ?? `After: ${p.title} in ${p.city}`} widths={[400, 700, 1000]} sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
                  <div class="ba-before absolute inset-0">
                    <Image src={p.before} alt={p.beforeAlt ?? `Before: ${p.title} in ${p.city}`} widths={[400, 700, 1000]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" />
                  </div>
                  <span class="absolute top-3 left-3 bg-ink/85 px-2.5 py-1 font-display text-sm font-bold uppercase tracking-wider">Before</span>
                  <span class="absolute top-3 right-3 bg-orange px-2.5 py-1 font-display text-sm font-bold uppercase tracking-wider text-ink">After</span>
                  <div class="ba-handle pointer-events-none absolute inset-y-0 w-[3px] bg-white" aria-hidden="true">
                    <span class="absolute top-1/2 left-1/2 grid size-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-orange text-ink shadow-lg"><Icon name="chevron" size={18} stroke={3} class="rotate-90" /><Icon name="chevron" size={18} stroke={3} class="-ml-2.5 -rotate-90" /></span>
                  </div>
                  <input type="range" min="0" max="100" value="50" class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" aria-label={`Compare before and after: ${p.title}`} />
                </div>
                <figcaption class="mt-4">
                  <span class="font-display text-xl font-bold uppercase">{p.title}</span>
                  <span class="text-mute"> · {p.city}, MO{getService(p.service) && <> · <a class="text-blue hover:underline" href={`/services/${p.service}/`}>{getService(p.service)!.name}</a></>}</span>
                  <p class="mt-1 text-mute">{p.summary}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        ) : (
          <div class="mt-12 grid items-center gap-8 lg:grid-cols-[1.2fr_1fr]">
            <figure class="reveal">
              <div class="ba-slider card relative aspect-[16/10] select-none overflow-hidden border-blue/30" style="--pos:55%">
                <!-- AFTER: clean garage (illustration) -->
                <svg class="absolute inset-0 h-full w-full" viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                  <rect width="640" height="400" fill="#16191d" />
                  <path d="M0 300h640" stroke="#00BFFF" stroke-opacity=".35" stroke-width="2" />
                  <path d="M60 300V90l260-50 260 50v210" fill="none" stroke="#00BFFF" stroke-opacity=".45" stroke-width="3" />
                  <path d="M130 300V150h380v150" fill="none" stroke="#00BFFF" stroke-opacity=".3" stroke-width="2" />
                  <path d="M130 190h380M130 230h380M130 270h380" stroke="#00BFFF" stroke-opacity=".12" stroke-width="2" />
                  <path d="M150 330h340" stroke="#fff" stroke-opacity=".08" stroke-width="12" />
                </svg>
                <!-- BEFORE: cluttered (illustration) -->
                <div class="ba-before absolute inset-0">
                  <svg class="h-full w-full" viewBox="0 0 640 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                    <rect width="640" height="400" fill="#121418" />
                    <path d="M0 300h640" stroke="#FF5F00" stroke-opacity=".4" stroke-width="2" />
                    <path d="M60 300V90l260-50 260 50v210" fill="none" stroke="#FF5F00" stroke-opacity=".35" stroke-width="3" />
                    <g fill="#202124" stroke="#FF5F00" stroke-opacity=".75" stroke-width="2.5">
                      <rect x="140" y="220" width="70" height="80" /><rect x="150" y="170" width="55" height="50" /><rect x="210" y="240" width="60" height="60" />
                      <path d="M280 300v-50h12v-24h120v24h12v50z" />
                      <rect x="440" y="160" width="58" height="140" /><rect x="505" y="230" width="50" height="70" /><rect x="510" y="190" width="40" height="40" />
                      <path d="M330 226l20-70 40 12-18 58" /><circle cx="110" cy="285" r="15" /><circle cx="70" cy="285" r="15" /><path d="M70 285l20-30h20l0 30" />
                      <rect x="360" y="180" width="60" height="44" /><rect x="225" y="200" width="40" height="40" />
                    </g>
                  </svg>
                </div>
                <span class="absolute top-3 left-3 bg-ink/90 px-2.5 py-1 font-display text-sm font-bold uppercase tracking-wider">Before</span>
                <span class="absolute top-3 right-3 bg-orange px-2.5 py-1 font-display text-sm font-bold uppercase tracking-wider text-ink">After</span>
                <div class="ba-handle pointer-events-none absolute inset-y-0 w-[3px] bg-white" aria-hidden="true">
                  <span class="absolute top-1/2 left-1/2 grid size-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-orange text-ink shadow-lg"><Icon name="chevron" size={16} stroke={3} class="rotate-90" /><Icon name="chevron" size={16} stroke={3} class="-ml-2 -rotate-90" /></span>
                </div>
                <input type="range" min="0" max="100" value="55" class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" aria-label="Compare before and after (illustration)" />
                <span class="absolute bottom-3 left-3 bg-ink/90 px-2 py-1 text-xs font-semibold text-mute">Illustration — real project photos coming soon</span>
              </div>
            </figure>
            <div class="reveal" style="--d:120ms">
              <ul class="space-y-4">
                {['Garages you can park in again', 'Basements and attics cleared to the walls', 'Rentals ready for the next tenant', 'Job sites cleared between phases'].map((t) => (
                  <li class="flex items-center gap-3 text-lg"><span class="grid size-8 shrink-0 place-items-center bg-blue/15 text-blue"><Icon name="check" size={18} stroke={3} /></span>{t}</li>
                ))}
              </ul>
              <p class="mt-6 text-mute">Want your space to be one of the first featured? Ask about it when we're out — photos are only ever shared with your permission.</p>
              <a href="/get-a-quote/" class="btn btn-primary mt-7" data-track="cta_click" data-cta="before_after">Get My Free Quote</a>
            </div>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .ba-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-handle { left: calc(var(--pos) - 1.5px); }
  .ba-range:focus-visible + * , .ba-slider:has(.ba-range:focus-visible) { outline: 3px solid var(--color-blue); outline-offset: 3px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.ba-slider').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.ba-range');
    range?.addEventListener('input', () => el.style.setProperty('--pos', `${range.value}%`));
  });
</script>
