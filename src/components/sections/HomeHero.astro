---
import Icon from '@/components/ui/Icon.astro';
import EstimateForm from '@/components/forms/EstimateForm.astro';
import { site, telHref } from '@/config/site';
---

<section class="hero relative isolate overflow-hidden bg-ink pt-28 pb-16 sm:pt-32 lg:min-h-[min(100svh,980px)] lg:pt-32 lg:pb-24" aria-labelledby="hero-title">
  <!-- backdrop -->
  <div class="grid-bg absolute inset-0 -z-30" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-30 bg-[radial-gradient(ellipse_70%_60%_at_20%_10%,rgb(0_191_255/0.14),transparent_60%)]" aria-hidden="true"></div>
  <div class="hero-slab absolute top-0 right-[-18%] -z-20 hidden h-full w-[62%] bg-gradient-to-br from-orange via-[#ff4d00] to-[#c43d00] lg:block" aria-hidden="true"></div>
  <div class="hero-slab-dark absolute top-0 right-[-14%] -z-20 h-full w-[50%] bg-ink/85 max-lg:hidden" aria-hidden="true"></div>
  <div class="hero-stripe absolute top-0 right-[calc(36%+0.5rem)] -z-10 h-full w-2.5 bg-blue shadow-[0_0_24px_rgb(0_191_255/0.7)] max-lg:hidden" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-32 bg-gradient-to-t from-ink to-transparent" aria-hidden="true"></div>

  <div class="hero-grid container-x grid gap-x-10 gap-y-8 lg:grid-cols-[1.05fr_1fr] lg:gap-y-6">
    <!-- a: headline -->
    <div class="relative z-10 [grid-area:a] lg:self-end">
      <p class="eyebrow animate-rise">Junk removal · Springfield, MO</p>
      <h1 id="hero-title" class="display mt-5 text-[3.3rem] leading-[0.84] xs:text-[3.9rem] sm:text-[5.2rem] lg:text-[5.6rem] xl:text-[6.6rem]">
        <span class="animate-rise block" style="--d:80ms">Junk gone.</span>
        <span class="animate-rise block text-orange [text-shadow:0_0_40px_rgb(255_95_0/0.35)]" style="--d:180ms">Problem</span>
        <span class="animate-rise block text-orange [text-shadow:0_0_40px_rgb(255_95_0/0.35)]" style="--d:240ms">solved.</span>
      </h1>
      <p class="animate-rise mt-5 font-display text-xl font-bold uppercase tracking-wide text-white sm:text-[1.6rem]" style="--d:320ms">
        Springfield's Local Junk Removal <span class="text-blue">&amp;</span> Hauling Crew
      </p>
    </div>

    <!-- b: estimate form (first thing after the headline on phones) -->
    <div class="relative z-10 [grid-area:b] lg:self-center lg:pl-4">
      <div class="m-slab absolute -inset-x-8 top-10 -bottom-6 -z-10 bg-gradient-to-br from-orange via-[#ff4d00] to-[#c43d00] lg:hidden" aria-hidden="true"></div>
      <div class="m-stripe absolute -inset-x-8 top-8 h-1.5 -z-10 bg-blue shadow-[0_0_20px_rgb(0_191_255/0.7)] lg:hidden" aria-hidden="true"></div>
      <div class="form-in">
        <EstimateForm />
      </div>
    </div>

    <!-- c: supporting copy -->
    <div class="relative z-10 [grid-area:c] lg:self-start">
      <p class="animate-rise max-w-xl text-lg text-[#cfd3d9]" style="--d:380ms">
        Got junk taking up space? We handle the heavy lifting, loading, and hauling so you don't have to. From a single bulky item to a complete property cleanout, Ozark Junk Removals makes getting your space back simple.
      </p>
      <div class="animate-rise mt-7 flex flex-col gap-3 xs:flex-row xs:flex-wrap xs:items-center" style="--d:450ms">
        <a href="#services" class="btn btn-outline btn-lg" data-track="cta_click" data-cta="hero_secondary">See What We Haul</a>
        {
          telHref && (
            <a href={telHref} class="inline-flex items-center gap-3 px-2 font-display text-xl font-bold tracking-wide hover:text-blue" data-track="call_click" data-cta="hero">
              <span class="grid size-10 place-items-center rounded-full bg-blue/15 text-blue"><Icon name="phone" size={20} /></span>
              Or call {site.phone}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero-slab { transform: skewX(-12deg); transform-origin: top; animation: slab-in 1.1s var(--ease-out-quint) both; }
  .hero-slab-dark { transform: skewX(-12deg); animation: slab-in 1.2s var(--ease-out-quint) 0.08s both; }
  .hero-stripe { transform: skewX(-12deg); animation: slab-in 1.2s var(--ease-out-quint) 0.15s both; }
  /* Mobile/tablet hero: slab sweeps in from the right, stripe follows */
  .m-slab { transform: skewY(-6deg); animation: m-slab-in 1s var(--ease-out-quint) 0.25s both; }
  .m-stripe { transform: skewY(-6deg); transform-origin: right; animation: m-stripe-in 0.9s var(--ease-out-quint) 0.55s both; }
  @keyframes m-slab-in { from { transform: translateX(105%) skewY(-6deg); } to { transform: skewY(-6deg); } }
  @keyframes m-stripe-in { from { transform: skewY(-6deg) scaleX(0); } to { transform: skewY(-6deg) scaleX(1); } }
  .hero-grid { grid-template-areas: 'a' 'b' 'c'; }
  @media (min-width: 1024px) { .hero-grid { grid-template-areas: 'a b' 'c b'; } }
  /* Form card slides in from the right after the headline */
  .form-in { animation: form-in 0.9s var(--ease-out-quint) 0.35s both; }
  @keyframes form-in { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: none; } }
  .pulse::before { animation: pulse-ring 2.4s 2s infinite; }
  @media (prefers-reduced-motion: reduce) { .pulse::before { animation: none; } }
</style>
