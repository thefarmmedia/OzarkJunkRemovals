---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import FaqAccordion from '@/components/ui/FaqAccordion.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import QuoteForm from '@/components/forms/QuoteForm.astro';
import { cities, cityPath, getCity, type City } from '@/data/cities';
import { services, getService, type Service } from '@/data/services';
import { offerCopy } from '@/config/offer';
import { service as serviceSchema, faqPage } from '@/lib/schema';
import { homeFaqs } from '@/data/faqs';

export function getStaticPaths() {
  return cities.map((c) => ({ params: { city: c.slug }, props: { city: c } }));
}

interface Props { city: City }
const { city: c } = Astro.props;
const origin = Astro.site?.origin ?? Astro.url.origin;
const path = cityPath(c.slug);
const featured = c.featuredServices.map(getService).filter(Boolean) as Service[];
const nearby = c.nearby.map(getCity).filter(Boolean) as City[];
// Springfield gets a fuller FAQ set (unique city FAQs + core site FAQs).
const faqs = c.primary ? [...c.faqs, ...homeFaqs.filter((f) => /cost|outside|can't take/i.test(f.q))] : c.faqs;
const crumbs = [
  { name: 'Service Areas', href: '/service-areas/' },
  { name: `${c.name}, MO`, href: path },
];
---

<BaseLayout
  title={c.seo.title}
  description={c.seo.description}
  crumbs={crumbs}
  schema={[serviceSchema(origin, { name: `Junk removal in ${c.name}, MO`, description: c.seo.description, path, area: `${c.name}, MO`, lat: c.lat, lon: c.lon }), faqPage(faqs)]}
>
  <PageHero eyebrow={`${c.county} · ${c.relation}`} title={c.h1} lead={c.lead} crumbs={crumbs} hasAside>
    <div slot="aside" class="card border-blue/25 p-6 sm:p-8">
      <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-blue">Service area details</p>
      <dl class="mt-5 space-y-4">
        <div class="flex justify-between gap-4 border-b border-line pb-3"><dt class="text-mute">City</dt><dd class="text-right font-bold">{c.name}, Missouri</dd></div>
        <div class="flex justify-between gap-4 border-b border-line pb-3"><dt class="text-mute">County</dt><dd class="text-right font-bold">{c.county}</dd></div>
        <div class="flex justify-between gap-4 border-b border-line pb-3"><dt class="text-mute">ZIP code{c.zips.length > 1 ? 's' : ''}</dt><dd class="text-right font-bold">{c.zips.join(', ')}</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-mute">Location</dt><dd class="text-right font-bold">{c.relation}</dd></div>
      </dl>
      <a href="#quote" class="btn btn-primary mt-7 w-full" data-track="cta_click" data-cta="city_aside">Check Availability in {c.name}</a>
    </div>
  </PageHero>

  <!-- Intro + local notes -->
  <section class="bg-ink py-20 lg:py-24" aria-labelledby="city-intro">
    <div class="container-x grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
      <div class="reveal">
        <p class="eyebrow mb-4">Local junk removal</p>
        <h2 id="city-intro" class="display text-4xl leading-[0.95] sm:text-5xl">Junk hauling for {c.name} homes &amp; businesses</h2>
        <div class="prose-oz mt-6">{c.body.map((p) => <p>{p}</p>)}</div>
        {
          c.areas && (
            <div class="mt-10">
              <h3 class="display text-2xl">Areas we cover in {c.name}</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {c.areas.map((a) => <li class="border border-white/10 bg-white/[0.03] px-3 py-1.5 text-[0.95rem]">{a}</li>)}
              </ul>
              <p class="mt-3 text-sm text-mute">…and every other Springfield neighborhood and ZIP code.</p>
            </div>
          )
        }
      </div>
      <aside class="reveal space-y-4" style="--d:120ms" aria-label={`Good to know in ${c.name}`}>
        <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-orange">Good to know</p>
        {c.localNotes.map((n) => (
          <div class="card p-6">
            <h3 class="font-display text-xl font-extrabold uppercase italic leading-tight">{n.title}</h3>
            <p class="mt-2 text-[0.98rem] text-mute">{n.text}</p>
          </div>
        ))}
        <a href="/garage-sale-junk-pickup/" class="card group flex items-center gap-4 border-orange/40 p-5 transition hover:border-orange">
          <Icon name="tag" size={26} class="shrink-0 text-orange" />
          <span><span class="block font-display text-lg font-bold uppercase leading-tight">Hosting a garage sale in {c.name}?</span><span class="text-sm text-mute">{offerCopy.short}.</span></span>
        </a>
      </aside>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-charcoal py-20 lg:py-24" aria-labelledby="city-services">
    <div class="container-x">
      <SectionHeading id="city-services" eyebrow={`Services in ${c.name}`} title={`What we haul in ${c.name}`} highlight={c.name} />
      <div class:list={['mt-12 grid gap-4 sm:grid-cols-2', featured.length > 5 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
        {featured.map((s) => <ServiceCard service={s} index={services.indexOf(s)} />)}
      </div>
    </div>
  </section>

  <HowItWorks />

  <!-- FAQ -->
  {
    faqs.length > 0 && (
      <section class="bg-charcoal py-20 lg:py-24" aria-labelledby="city-faq">
        <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr]">
          <SectionHeading id="city-faq" eyebrow="FAQ" title={`Junk removal in ${c.name}: FAQ`} />
          <FaqAccordion faqs={faqs} />
        </div>
      </section>
    )
  }

  <!-- Quote -->
  <section id="quote" class="relative overflow-hidden bg-ink py-20 lg:py-24" aria-label={`Request a quote in ${c.name}`}>
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div class="container-x relative grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:items-start">
      <div class="reveal lg:sticky lg:top-32">
        <p class="eyebrow mb-4">Free estimate</p>
        <p class="display text-4xl leading-[0.95] sm:text-5xl">Get a {c.name} junk removal estimate</p>
        <p class="mt-4 text-lg text-mute">Tell us what needs to go and add a few photos. We'll follow up with a straightforward estimate.</p>
        <div class="mt-8">
          <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-blue">Nearby areas we serve</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {nearby.map((n) => <li><a href={cityPath(n.slug)} class="inline-block border border-blue/30 px-3 py-1.5 text-[0.95rem] font-semibold transition hover:border-blue hover:bg-blue hover:text-ink">{n.name}</a></li>)}
          </ul>
        </div>
      </div>
      <QuoteForm idPrefix="city" defaultCity={c.slug} heading={`${c.name} estimate`} />
    </div>
  </section>

  <CtaBand title={`Junk taking up space in ${c.name}?`} />
</BaseLayout>
