---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';

const crumbs = [{ name: 'About', href: '/about/' }];
const values: { icon: IconName; title: string; text: string }[] = [
  { icon: 'clipboard', title: 'Straight talk', text: "You'll know the estimate and the plan before anything gets loaded. If something isn't a fit for us, we'll say so." },
  { icon: 'lift', title: 'We do the work', text: "No 'curbside only' fine print. Our crew carries items out of basements, attics, back rooms and yards." },
  { icon: 'house', title: 'Respect for your place', text: 'We plan the route out, work carefully around walls and floors, and leave the area we worked in swept.' },
  { icon: 'heart', title: 'Respect for people', text: 'Estates, downsizing and hoarding situations are personal. We keep those jobs discreet and unhurried.' },
  { icon: 'recycle', title: 'Disposal done right', text: 'Usable items go to donation where it is practical and accepted. Hazardous materials are never mixed into a junk load.' },
  { icon: 'local', title: 'Local and reachable', text: 'Locally operated in the Springfield area — not a national call center booking your job.' },
];
---

<BaseLayout
  pageType="AboutPage"
  title="About Ozark Junk Removals | Springfield, MO Junk Removal"
  description="Ozark Junk Removals is a locally operated junk removal and hauling company in Springfield, MO. Learn how we work and what you can expect from our crew."
  crumbs={crumbs}
>
  <PageHero
    eyebrow="About us"
    title="A local crew that does the heavy lifting"
    lead="Ozark Junk Removals is a locally operated, full-service junk removal and hauling company serving Springfield and Southwest Missouri. We started with a simple idea: getting rid of junk shouldn't take your whole weekend."
    crumbs={crumbs}
  />

  <section class="bg-ink py-20 lg:py-24" aria-labelledby="story-title">
    <div class="container-x grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
      <div class="reveal">
        <p class="eyebrow mb-4">How we work</p>
        <h2 id="story-title" class="display text-4xl leading-[0.95] sm:text-5xl">Full service means <span class="text-orange">full service.</span></h2>
        <div class="prose-oz mt-6">
          <p>A lot of people put off dealing with junk because the options are all a hassle: rent a trailer, borrow a truck, wait on bulky-item pickup, or let a dumpster sit in the driveway for a week. We do it differently. Our crew comes to your property, loads everything that's going and hauls it away. You don't lift a thing.</p>
          <p>We run a dump trailer for heavy, dense material like remodel debris and a high-side hauling trailer for bulky loads like furniture and cleanouts. That means one visit handles most jobs — from a single couch to a full garage.</p>
          <p>Our customers are homeowners, landlords, property managers, realtors, estate executors, contractors and local businesses. They all want the same things: show up when you say you will, be honest about the estimate, and leave the place better than you found it. That's the standard we hold ourselves to.</p>
        </div>
      </div>
      <aside class="reveal" style="--d:120ms" aria-label="Our equipment">
        <div class="card border-blue/25 p-7">
          <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-blue">Equipment</p>
          <ul class="mt-5 space-y-5">
            <li class="flex gap-4"><Icon name="trailer" size={34} class="shrink-0 text-orange" /><span><span class="block font-display text-2xl font-extrabold uppercase italic leading-none">Dump trailer</span><span class="text-mute">For heavy, dense debris — drywall, lumber, yard waste, remodel material.</span></span></li>
            <li class="flex gap-4"><Icon name="truck" size={34} class="shrink-0 text-orange" /><span><span class="block font-display text-2xl font-extrabold uppercase italic leading-none">High-side hauling trailer</span><span class="text-mute">For bulky volume — furniture, appliances, garage and property cleanouts.</span></span></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-charcoal py-20 lg:py-24" aria-labelledby="values-title">
    <div class="container-x">
      <SectionHeading id="values-title" eyebrow="What you can expect" title="How we do business" />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {values.map((v, i) => (
          <li class="card reveal p-7" style={`--d:${(i % 3) * 80}ms`}>
            <Icon name={v.icon} size={32} class="text-orange" />
            <h3 class="mt-5 font-display text-2xl font-extrabold uppercase italic leading-none">{v.title}</h3>
            <p class="mt-3 text-mute">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
