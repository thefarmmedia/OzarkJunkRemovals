---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, telHref } from '@/config/site';
import { services } from '@/data/services';
---

<BaseLayout
  title="Thanks — We Got Your Request | Ozark Junk Removals"
  description="Thanks for contacting Ozark Junk Removals. We received your request and will follow up soon."
  noindex
  hideMobileCta
>
  <section class="relative isolate flex min-h-[80vh] items-center overflow-hidden bg-ink pt-36 pb-24">
    <div class="grid-bg absolute inset-0 -z-20" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_50%_50%_at_50%_30%,rgb(255_95_0/0.2),transparent_70%)]" aria-hidden="true"></div>
    <div class="container-x text-center">
      <div class="animate-rise mx-auto grid size-24 place-items-center bg-orange text-ink" style="clip-path: polygon(0 0, 78% 0, 100% 22%, 100% 100%, 22% 100%, 0 78%)">
        <Icon name="check" size={48} stroke={3.5} />
      </div>
      <h1 class="display animate-rise mt-8 text-[3.2rem] leading-[0.88] sm:text-7xl" style="--d:100ms">Request received.<span class="block text-orange">We're on it.</span></h1>
      <p id="ty-msg" class="animate-rise mx-auto mt-6 max-w-xl text-lg text-[#d7dbe1]" style="--d:180ms">
        Thanks for reaching out to {site.name}. We'll review the details you sent and follow up with your estimate and next steps.
      </p>

      <ol class="animate-rise mx-auto mt-12 grid max-w-3xl gap-4 text-left sm:grid-cols-3" style="--d:260ms">
        <li class="card p-5"><span class="font-display text-sm font-bold uppercase tracking-widest text-blue">Step 1 · Done</span><p class="mt-1 font-semibold">You told us what needs to go.</p></li>
        <li class="card border-orange/50 p-5"><span class="font-display text-sm font-bold uppercase tracking-widest text-orange">Step 2 · Next</span><p class="mt-1 font-semibold">We review it and reach out with an estimate.</p></li>
        <li class="card p-5"><span class="font-display text-sm font-bold uppercase tracking-widest text-mute">Step 3</span><p class="mt-1 font-semibold">We load it up and haul it away.</p></li>
      </ol>

      <div class="animate-rise mt-12 flex flex-col justify-center gap-3 sm:flex-row" style="--d:320ms">
        {telHref && <a href={telHref} class="btn btn-primary btn-lg" data-track="call_click" data-cta="thank_you"><Icon name="phone" size={20} /> Need it sooner? Call {site.phone}</a>}
        <a href="/" class="btn btn-outline btn-lg">Back to Home</a>
      </div>

      <nav class="animate-rise mt-14" style="--d:380ms" aria-label="Explore services">
        <p class="text-sm text-mute">While you wait, see what else we haul:</p>
        <ul class="mt-3 flex flex-wrap justify-center gap-2">
          {services.map((s) => <li><a href={`/services/${s.slug}/`} class="inline-block border border-white/10 px-3 py-1.5 text-sm transition hover:border-blue hover:text-blue">{s.name}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(location.search);
  if (params.get('form') === 'garage-sale-pickup') {
    const msg = document.getElementById('ty-msg');
    if (msg) msg.textContent = "Thanks! We got your garage-sale pickup request. We'll confirm eligibility, timing and what we can take — before your sale ends whenever possible.";
  }
  // Fire a page-level conversion event once per submission (useful as a GTM trigger).
  try {
    const form = sessionStorage.getItem('oz-submitted');
    if (form) {
      window.ozTrack?.('lead_thank_you_view', { form_name: form });
      sessionStorage.removeItem('oz-submitted');
    }
  } catch {}
</script>
