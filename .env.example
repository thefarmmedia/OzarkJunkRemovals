# Copy to .env for local builds. In production, set these in Netlify:
# Site configuration > Environment variables. Every value is optional;
# features that depend on a value stay switched off until it is set.

# Canonical production origin, no trailing slash. Leave unset until the domain is live.
SITE_URL=

# ---- Business contact (only publish verified details) ----
# E.164 or display format, e.g. "(417) 555-0100". Enables click-to-call everywhere.
PUBLIC_PHONE=
# Public email shown in the footer/contact areas.
PUBLIC_EMAIL=

# ---- Tracking (all load only after visitor consent) ----
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
# Google Ads: conversion ID (AW-XXXXXXXXX) and the label for the "lead" conversion.
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_META_PIXEL_ID=
# Call tracking (e.g. CallRail swap script URL). Loaded only after consent.
PUBLIC_CALL_TRACKING_SCRIPT=

# ---- CRM (server-side only — NOT a PUBLIC_ variable) ----
# GoHighLevel / LeadConnector inbound webhook. Every verified form submission is
# forwarded here by netlify/functions/submission-created.mjs. Keep it out of git.
GHL_WEBHOOK_URL=
